// Simple PowerBuilder grammar for testing

start: program

program: item*

item: type_declaration
    | function_declaration
    | variable_declaration
    | event_declaration
    | object_declaration
    | COMMENT
    | EXPORT_HEADER

type_declaration: "type" IDENTIFIER "from" IDENTIFIER "end" "type"

function_declaration: ("global"|"function"|"subroutine") "function" IDENTIFIER "(" parameter_list? ")" return_type? ";" statement* "end" "function"

parameter_list: parameter ("," parameter)*
parameter: IDENTIFIER IDENTIFIER

return_type: IDENTIFIER

variable_declaration: IDENTIFIER IDENTIFIER ("=" value)?

event_declaration: "event" IDENTIFIER ";" statement* "end" "event"

object_declaration: "global" "type" IDENTIFIER "from" IDENTIFIER statement* "end" "type"

statement: assignment
         | if_statement
         | choose_statement
         | return_statement
         | function_call
         | IDENTIFIER

assignment: IDENTIFIER "=" value

if_statement: "if" expression "then" statement* ("else" statement*)? "end" "if"

choose_statement: "choose" "case" expression case_item* ("case" "else" statement*)? "end" "choose"

case_item: "case" value statement*

return_statement: "return" value?

function_call: IDENTIFIER "(" argument_list? ")"

argument_list: expression ("," expression)*

expression: value
          | IDENTIFIER
          | function_call
          | comparison

comparison: expression ("=" | "<>" | "<" | ">" | "<=" | ">=") expression

value: STRING
     | NUMBER
     | BOOLEAN
     | IDENTIFIER

EXPORT_HEADER: /\$PBExportHeader\$.*/

BOOLEAN: "true" | "false"

IDENTIFIER: /[a-zA-Z_][a-zA-Z0-9_]*/

STRING: /"[^"]*"/

NUMBER: /\d+(\.\d+)?/

COMMENT: /\/\/[^\n]*/

%import common.WS
%ignore WS
