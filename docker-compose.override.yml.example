# Docker Compose Override Example
# Copy this file to docker-compose.override.yml and customize for your local environment

version: '3.8'

services:
  powerrebuilder-dev:
    # Mount additional directories for development
    volumes:
      # Mount your PowerBuilder projects
      - ~/PowerBuilderProjects:/pb_projects:ro
      # Mount custom scripts
      - ./scripts:/scripts
    environment:
      # Custom environment variables
      - DEBUG=true
      - PROFILE=development
      # Database connection for development
      - DATABASE_URL=postgresql://powerrebuilder:localpass@postgres:5432/powerrebuilder_dev
    # Override command for specific development needs
    # command: ["uv", "run", "python", "-m", "powerrebuilder", "watch", "/pb_projects"]

  postgres:
    # Use different credentials for local development
    environment:
      - POSTGRES_PASSWORD=localpass
    # Expose PostgreSQL for external tools
    ports:
      - "15432:5432"

  # Add pgAdmin for database management
  pgadmin:
    image: dpage/pgadmin4:latest
    container_name: powerrebuilder-pgadmin
    environment:
      - PGADMIN_DEFAULT_EMAIL=admin@local.dev
      - PGADMIN_DEFAULT_PASSWORD=admin
      - PGADMIN_CONFIG_SERVER_MODE=False
    ports:
      - "5050:80"
    networks:
      - powerrebuilder-network
    depends_on:
      - postgres

  # Add MinIO for S3-compatible storage
  minio:
    image: minio/minio:latest
    container_name: powerrebuilder-minio
    command: server /data --console-address ":9001"
    environment:
      - MINIO_ROOT_USER=minioadmin
      - MINIO_ROOT_PASSWORD=minioadmin
    ports:
      - "9000:9000"
      - "9001:9001"
    volumes:
      - minio-data:/data
    networks:
      - powerrebuilder-network

volumes:
  minio-data:
