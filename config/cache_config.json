{
  "cache": {
    "enabled": true,
    "directory": "~/.powerrebuilder/cache",
    "stages": {
      "extract": {
        "enabled": true,
        "type": "file",
        "ttl": 86400,
        "description": "Cache extracted file metadata for 24 hours"
      },
      "decompile": {
        "enabled": true,
        "type": "file",
        "ttl": 86400,
        "description": "Cache decompiled PowerBuilder source for 24 hours"
      },
      "parse": {
        "enabled": true,
        "type": "hybrid",
        "memory_size": 500,
        "ttl": 43200,
        "description": "Use both memory and file cache for parsed ASTs"
      },
      "model": {
        "enabled": true,
        "type": "memory",
        "size": 500,
        "description": "In-memory cache for semantic models"
      },
      "generate": {
        "enabled": true,
        "type": "file",
        "ttl": 604800,
        "description": "Cache generated code for 7 days"
      }
    },
    "performance": {
      "max_memory_mb": 512,
      "eviction_policy": "lru",
      "compression": false,
      "parallel_cache_operations": true
    },
    "monitoring": {
      "log_cache_stats": true,
      "stats_interval_seconds": 300,
      "alert_on_low_hit_rate": true,
      "min_hit_rate_threshold": 0.5
    }
  }
}
